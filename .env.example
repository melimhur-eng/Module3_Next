# Copy this file to .env.local and replace the value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# The public address of the site, used for social previews and the sitemap.
# Not a secret: NEXT_PUBLIC_ values are built into the browser JavaScript.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
